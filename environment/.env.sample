# copy to environment/.env
# Hugging Face token for gated or private models and datasets; public ones need none
HF_TOKEN=

# API job table (SQLite); jobs survive a server restart
JOBS_DB=./output/_jobs.sqlite
# Jobs the API runs at once. Each worker owns one accelerator: use the number of GPUs. Keep 1 on a single GPU or a Mac.
JOB_WORKERS=1

# Shared secret for every /api route (`Authorization: Bearer <token>`); empty leaves the API open. Set it on any
# server that others can reach: the API reads files and starts training on the server's behalf.
API_TOKEN=
# Directories (colon-separated) the API may read configs and rows from and write output to; anything else is 403.
API_PATHS=.
